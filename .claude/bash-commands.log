from pathlib import Path

pages = [Path(name) for name in ("index.html", "blog.html", "bio.html", "cv.html")]
missing = [str(page) for page in pages if './js/script.js' not in page.read_text()]
if missing:
    raise SystemExit(f"Missing ambient script: {missing}")

script = Path("js/script.js").read_text()
checks = {
    "30-second delay": "}, 30000);",
    "pointer input": 'addEventListener("pointermove"',
    "reduced motion": 'prefers-reduced-motion: reduce',
    "eased movement": "deltaX * 0.045",
}
failed = [name for name, needle in checks.items() if needle not in script]
if failed:
    raise SystemExit(f"Missing behavior: {failed}")

workflow = Path(".github/workflows/build-cv.yml").read_text()
if '<script defer src="./js/script.js"></script>' not in workflow:
    raise SystemExit("CV workflow will not preserve the script tag")

print("Verified:", ", ".join(checks))
print("Pages:", ", ".join(str(page) for page in pages))
PY
