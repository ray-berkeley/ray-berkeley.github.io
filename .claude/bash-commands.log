from html.parser import HTMLParser
from pathlib import Path
import re

class TextParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.parts = []
        self.hrefs = []

    def handle_data(self, data):
        self.parts.append(data)

    def handle_starttag(self, tag, attrs):
        if tag == "a":
            self.hrefs.extend(value for name, value in attrs if name == "href")

html = Path("cv.html").read_text()
parser = TextParser()
parser.feed(html)
text = re.sub(r"\s+", " ", "".join(parser.parts))
if "( link" in text:
    raise SystemExit("Whitespace remains after an opening parenthesis")
if "(link, pdf)" not in text:
    raise SystemExit("Expected publication link text was not found")

pdf_href = next(href for href in parser.hrefs if href.endswith("RayBerkeley_CV.pdf"))
pdf_path = Path(pdf_href.removeprefix("./"))
if not pdf_path.is_file():
    raise SystemExit(f"PDF target does not exist: {pdf_path}")

print("Rendered link text includes: (link, pdf)")
print(f"PDF target exists: {pdf_path} ({pdf_path.stat().st_size:,} bytes)")
