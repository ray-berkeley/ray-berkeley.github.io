from pathlib import Path
import re

html = Path('cv.html').read_text()
if re.search(r'\(\s+<a\b', html):
    raise SystemExit('Found whitespace between an opening parenthesis and link')

workflow = Path('.github/workflows/build-cv.yml').read_text()
required = [
    "run: cp assets/cv/cv.pdf RayBerkeley_CV.pdf",
    "pdf_name = 'RayBerkeley_CV.pdf'",
    "cv_body = re.sub(r'\\(\\s+(?=<a\\b)', '(', cv_body)",
    "git add cv.html RayBerkeley_CV.pdf",
]
missing = [item for item in required if item not in workflow]
if missing:
    raise SystemExit(f'Missing workflow behavior: {missing}')

current_pdf = re.search(r'href="\./(RayBerkeley_CV_[^"]+\.pdf)"', html).group(1)
if not Path(current_pdf).is_file():
    raise SystemExit(f'Current HTML PDF is missing: {current_pdf}')

print(f'Current HTML PDF exists: {current_pdf}')
print('Future builds use stable PDF: RayBerkeley_CV.pdf')
print('Publication link spacing verified')
