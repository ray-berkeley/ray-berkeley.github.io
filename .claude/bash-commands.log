let timeoutDelay = null;
let timeoutCallback = null;
let pointerHandler = null;
let resizeHandler = null;
let visible = false;
let prepended = null;
const context = {
  setTransform() {}, clearRect() {}, save() {}, translate() {}, rotate() {},
  beginPath() {}, ellipse() {}, stroke() {}, restore() {},
  set lineWidth(value) {}, set strokeStyle(value) {}
};
const canvas = {
  className: '', width: 0, height: 0,
  setAttribute() {}, getContext() { return context; }
};
global.document = {
  body: {
    prepend(element) { prepended = element; },
    classList: { add(name) { visible = name === 'ambient-contours-visible'; } }
  },
  createElement(name) { if (name !== 'canvas') process.exit(1); return canvas; }
};
global.window = {
  innerWidth: 1000, innerHeight: 800, devicePixelRatio: 2,
  performance: { now() { return 1000; } },
  matchMedia() { return { matches: false }; },
  addEventListener(name, handler) {
    if (name === 'pointermove') pointerHandler = handler;
    if (name === 'resize') resizeHandler = handler;
  },
  requestAnimationFrame() { return 1; },
  setTimeout(callback, delay) { timeoutCallback = callback; timeoutDelay = delay; }
};
require('./js/script.js');
if (prepended !== canvas || timeoutDelay !== 30000 || !pointerHandler || !resizeHandler) process.exit(1);
timeoutCallback();
if (!visible || canvas.width !== 2000 || canvas.height !== 1600) process.exit(1);
