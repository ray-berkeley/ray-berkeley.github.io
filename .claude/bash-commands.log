let timeoutDelay = null;
let timeoutCallback = null;
let pointerHandler = null;
let visible = false;

global.document = {
  documentElement: { style: { setProperty() {} } },
  body: { classList: { add(name) { visible = name === 'ambient-gradient-visible'; } } }
};
global.window = {
  innerWidth: 1000,
  innerHeight: 800,
  matchMedia() { return { matches: false }; },
  addEventListener(name, handler) { if (name === 'pointermove') pointerHandler = handler; },
  requestAnimationFrame() { return 1; },
  setTimeout(callback, delay) { timeoutCallback = callback; timeoutDelay = delay; }
};

require('./js/script.js');
if (timeoutDelay !== 30000 || !pointerHandler || !timeoutCallback) process.exit(1);
timeoutCallback();
if (!visible) process.exit(1);
console.log('Runtime behavior verified');
